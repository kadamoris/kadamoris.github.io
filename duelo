<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sendero de Luz · Grupo de Apoyo en el Duelo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">

<style>
  :root {
    --sage: #8a9e8c;
    --sage-light: #b5c4b6;
    --sage-pale: #dce7dc;
    --beige: #f2ede4;
    --beige-warm: #e8dfd0;
    --beige-dark: #c8bca8;
    --grey-soft: #6b6b6b;
    --grey-muted: #9a9a9a;
    --grey-pale: #f5f5f3;
    --text-dark: #2d2d2d;
    --text-medium: #4a4a4a;
    --white: #fdfcfa;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Jost', sans-serif;
    background-color: var(--white);
    color: var(--text-dark);
    font-weight: 300;
    overflow-x: hidden;
  }

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 100;
    padding: 1.4rem 4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(253, 252, 250, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(138, 158, 140, 0.15);
  }

  .nav-logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--sage);
  }

  .nav-logo span {
    color: var(--text-dark);
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
  }

  .nav-links a {
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--grey-soft);
    text-decoration: none;
    transition: color 0.3s;
  }

  .nav-links a:hover {
    color: var(--sage);
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1518173946687-a4c8892bbd9f?w=1800&q=80');
    background-size: cover;
    background-position: center 30%;
    transform: scale(1.04);
    animation: slowZoom 20s ease-out forwards;
  }

  @keyframes slowZoom {
    to { transform: scale(1); }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(242, 237, 228, 0.92) 0%,
      rgba(242, 237, 228, 0.78) 45%,
      rgba(138, 158, 140, 0.15) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: 0 4rem;
    max-width: 680px;
    animation: fadeUp 1.2s ease-out 0.3s both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-tag {
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sage);
    border: 1px solid var(--sage-light);
    padding: 0.45rem 1rem;
    border-radius: 50px;
    margin-bottom: 2rem;
    background: rgba(255,255,255,0.5);
  }

  .hero h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.8rem, 5.5vw, 4.5rem);
    font-weight: 300;
    line-height: 1.18;
    color: var(--text-dark);
    margin-bottom: 1.6rem;
  }

  .hero h1 em {
    font-style: italic;
    color: var(--sage);
  }

  .hero p {
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--text-medium);
    max-width: 520px;
    margin-bottom: 2.8rem;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--sage);
    color: white;
    text-decoration: none;
    padding: 1rem 2.2rem;
    border-radius: 50px;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    font-weight: 400;
    transition: all 0.35s ease;
    box-shadow: 0 8px 32px rgba(138, 158, 140, 0.35);
  }

  .hero-cta:hover {
    background: #7a8e7c;
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(138, 158, 140, 0.45);
  }

  .hero-cta svg {
    width: 18px;
    height: 18px;
  }

  .hero-detail {
    position: absolute;
    bottom: 2.5rem;
    right: 4rem;
    z-index: 2;
    text-align: right;
    animation: fadeUp 1.4s ease-out 0.8s both;
  }

  .hero-detail p {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--text-medium);
    text-transform: uppercase;
  }

  .hero-detail .days {
    font-family: 'Cormorant Garamond', serif;
    font-size: 4rem;
    font-weight: 300;
    color: var(--sage);
    line-height: 1;
    display: block;
  }

  /* ── DIVIDER ── */
  .section-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--beige-dark), transparent);
    margin: 0 4rem;
  }

  /* ── INTRO QUOTE ── */
  .quote-section {
    padding: 6rem 4rem;
    background: var(--beige);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .quote-section::before {
    content: '"';
    font-family: 'Cormorant Garamond', serif;
    font-size: 18rem;
    color: rgba(138, 158, 140, 0.08);
    position: absolute;
    top: -4rem;
    left: 50%;
    transform: translateX(-50%);
    line-height: 1;
    pointer-events: none;
  }

  .quote-section blockquote {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 300;
    font-style: italic;
    color: var(--text-medium);
    max-width: 760px;
    margin: 0 auto 1.5rem;
    line-height: 1.65;
    position: relative;
    z-index: 1;
  }

  .quote-section cite {
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--sage);
    font-style: normal;
  }

  /* ── WHAT YOU WILL FIND ── */
  .features {
    padding: 7rem 4rem;
    background: var(--white);
  }

  .section-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .section-label {
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--sage);
    display: block;
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    color: var(--text-dark);
    line-height: 1.3;
  }

  .section-subtitle {
    margin-top: 1rem;
    color: var(--grey-muted);
    font-size: 0.95rem;
    line-height: 1.75;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .feature-card {
    background: var(--grey-pale);
    border: 1px solid rgba(138, 158, 140, 0.12);
    border-radius: 20px;
    padding: 3rem 2.5rem;
    position: relative;
    overflow: hidden;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .feature-card::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--sage-light), var(--sage));
    transform: scaleX(0);
    transition: transform 0.4s ease;
    transform-origin: left;
  }

  .feature-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.07);
  }

  .feature-card:hover::after {
    transform: scaleX(1);
  }

  .feature-icon {
    width: 52px;
    height: 52px;
    background: var(--sage-pale);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.8rem;
  }

  .feature-icon svg {
    width: 24px;
    height: 24px;
    stroke: var(--sage);
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .feature-card h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.45rem;
    font-weight: 400;
    color: var(--text-dark);
    margin-bottom: 0.9rem;
  }

  .feature-card p {
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--grey-soft);
  }

  .feature-number {
    position: absolute;
    top: 2rem;
    right: 2rem;
    font-family: 'Cormorant Garamond', serif;
    font-size: 3.5rem;
    font-weight: 300;
    color: rgba(138, 158, 140, 0.1);
    line-height: 1;
  }

  /* ── HOW IT WORKS ── */
  .process {
    padding: 7rem 4rem;
    background: var(--beige);
  }

  .process-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
  }

  .process-image {
    position: relative;
  }

  .process-image img {
    width: 100%;
    height: 560px;
    object-fit: cover;
    border-radius: 20px;
  }

  .process-badge {
    position: absolute;
    bottom: -1.5rem;
    right: -1.5rem;
    background: var(--sage);
    color: white;
    border-radius: 16px;
    padding: 1.5rem 2rem;
    text-align: center;
    box-shadow: 0 12px 40px rgba(138, 158, 140, 0.4);
  }

  .process-badge .num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.8rem;
    font-weight: 300;
    line-height: 1;
    display: block;
  }

  .process-badge .label {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
    display: block;
    margin-top: 0.3rem;
  }

  .process-content .section-header {
    text-align: left;
    margin-bottom: 3rem;
  }

  .process-steps {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .step {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .step-dot {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--sage-pale);
    border: 1.5px solid var(--sage-light);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    color: var(--sage);
    margin-top: 0.1rem;
  }

  .step-text h4 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--text-dark);
    margin-bottom: 0.4rem;
  }

  .step-text p {
    font-size: 0.88rem;
    line-height: 1.75;
    color: var(--grey-soft);
  }

  /* ── BIO ── */
  .bio {
    padding: 7rem 4rem;
    background: var(--white);
  }

  .bio-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 6rem;
    align-items: start;
  }

  .bio-image-wrap {
    position: sticky;
    top: 100px;
  }

  .bio-image-frame {
    position: relative;
  }

  .bio-image-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid var(--sage-light);
    border-radius: 20px;
    transform: translate(10px, 10px);
    z-index: 0;
  }

  .bio-image-frame img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    object-position: center top;
    border-radius: 20px;
    position: relative;
    z-index: 1;
    filter: saturate(0.9);
  }

  .bio-credential {
    background: var(--beige);
    border-radius: 16px;
    padding: 1.5rem 2rem;
    margin-top: 1.5rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    border: 1px solid var(--beige-dark);
  }

  .bio-credential svg {
    width: 28px;
    height: 28px;
    stroke: var(--sage);
    fill: none;
    stroke-width: 1.5;
    flex-shrink: 0;
  }

  .bio-credential p {
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--grey-soft);
  }

  .bio-credential strong {
    display: block;
    color: var(--text-dark);
    font-weight: 500;
    margin-bottom: 0.2rem;
  }

  .bio-content .section-header {
    text-align: left;
    margin-bottom: 2.5rem;
  }

  .bio-text {
    font-size: 0.97rem;
    line-height: 1.95;
    color: var(--text-medium);
    margin-bottom: 1.5rem;
  }

  .bio-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .bio-tag {
    background: var(--sage-pale);
    color: var(--sage);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    padding: 0.5rem 1.1rem;
    border-radius: 50px;
    border: 1px solid var(--sage-light);
  }

  /* ── TESTIMONIALS ── */
  .testimonials {
    padding: 7rem 4rem;
    background: var(--sage);
    position: relative;
    overflow: hidden;
  }

  .testimonials::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=1800&q=80');
    background-size: cover;
    background-position: center;
    opacity: 0.08;
  }

  .testimonials .section-header {
    position: relative;
    z-index: 1;
  }

  .testimonials .section-label {
    color: rgba(255,255,255,0.7);
  }

  .testimonials .section-title {
    color: white;
  }

  .testimonials .section-subtitle {
    color: rgba(255,255,255,0.65);
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .testimonial-card {
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 20px;
    padding: 2.5rem;
  }

  .testimonial-stars {
    display: flex;
    gap: 3px;
    margin-bottom: 1.2rem;
  }

  .star {
    width: 14px;
    height: 14px;
    fill: var(--beige-warm);
  }

  .testimonial-text {
    font-size: 0.92rem;
    line-height: 1.85;
    color: rgba(255,255,255,0.88);
    font-style: italic;
    margin-bottom: 1.5rem;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.05rem;
  }

  .testimonial-author {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.55);
    letter-spacing: 0.05em;
  }

  /* ── CTA ── */
  .cta-section {
    padding: 8rem 4rem;
    background: var(--beige);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cta-section::before {
    content: '';
    position: absolute;
    top: -40%;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(138, 158, 140, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin: 0 auto;
  }

  .cta-section .section-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    margin-bottom: 1.5rem;
  }

  .cta-section p {
    font-size: 1rem;
    line-height: 1.85;
    color: var(--grey-soft);
    margin-bottom: 3rem;
  }

  .cta-main {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    background: #25D366;
    color: white;
    text-decoration: none;
    padding: 1.15rem 2.5rem;
    border-radius: 50px;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    font-weight: 500;
    transition: all 0.35s ease;
    box-shadow: 0 8px 36px rgba(37, 211, 102, 0.35);
    margin-bottom: 1.5rem;
  }

  .cta-main:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 48px rgba(37, 211, 102, 0.45);
    background: #1ebf5a;
  }

  .cta-main svg {
    width: 22px;
    height: 22px;
    fill: white;
  }

  .cta-note {
    font-size: 0.78rem;
    color: var(--grey-muted);
    letter-spacing: 0.05em;
  }

  .cta-note span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0.8rem;
  }

  .cta-note svg {
    width: 14px;
    height: 14px;
    stroke: var(--sage);
    fill: none;
    stroke-width: 2;
  }

  /* ── FOOTER ── */
  footer {
    background: #2d2d2d;
    color: rgba(255,255,255,0.5);
    padding: 3rem 4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem;
    color: rgba(255,255,255,0.75);
  }

  footer p {
    font-size: 0.78rem;
    line-height: 1.6;
  }

  footer a {
    color: var(--sage-light);
    text-decoration: none;
  }

  /* ── SCROLL REVEALS ── */
  .reveal {
    opacity: 0;
    transform: translateY(25px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    nav { padding: 1.2rem 2rem; }
    .nav-links { display: none; }
    .hero-content { padding: 0 2rem; max-width: 100%; }
    .hero-detail { display: none; }
    .features { padding: 5rem 2rem; }
    .features-grid { grid-template-columns: 1fr; }
    .quote-section { padding: 5rem 2rem; }
    .process { padding: 5rem 2rem; }
    .process-inner { grid-template-columns: 1fr; gap: 3rem; }
    .process-image img { height: 300px; }
    .bio { padding: 5rem 2rem; }
    .bio-inner { grid-template-columns: 1fr; gap: 3rem; }
    .bio-image-wrap { position: static; }
    .bio-image-frame img { height: 360px; }
    .testimonials { padding: 5rem 2rem; }
    .testimonials-grid { grid-template-columns: 1fr; }
    .cta-section { padding: 6rem 2rem; }
    footer { padding: 2.5rem 2rem; flex-direction: column; text-align: center; }
    .section-divider { margin: 0 2rem; }
  }

  /* ── PROGRAMA 30 DÍAS ── */
  .programa {
    padding: 7rem 4rem;
    background: var(--beige);
  }

  .programa-intro {
    max-width: 1100px;
    margin: 0 auto;
  }

  .semanas-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .semana-card {
    background: var(--white);
    border-radius: 20px;
    padding: 2.5rem;
    border: 1px solid rgba(138, 158, 140, 0.15);
    position: relative;
    overflow: hidden;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .semana-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(0,0,0,0.07);
  }

  .semana-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--sage-light), var(--sage));
  }

  .semana-card:nth-child(2)::before { background: linear-gradient(90deg, #b5c4b6, #8a9e8c); }
  .semana-card:nth-child(3)::before { background: linear-gradient(90deg, var(--beige-dark), #b5a990); }
  .semana-card:nth-child(4)::before { background: linear-gradient(90deg, var(--sage), #6a8a6c); }

  .semana-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.8rem;
  }

  .semana-badge {
    background: var(--sage-pale);
    color: var(--sage);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.4rem 0.9rem;
    border-radius: 50px;
